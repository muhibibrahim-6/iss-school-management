
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ISS_OWNER
  SCHOOL_ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

model School {
  id           String             @id @default(cuid())
  name         String
  slug         String             @unique
  email        String?
  phone        String?
  address      String?
  logoUrl      String?
  primaryColor String             @default("#2563EB")
  accentColor  String             @default("#7C3AED")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  memberships  SchoolMembership[]
  classes      SchoolClass[]
  students     Student[]
  attendance   Attendance[]
  subjects     Subject[]
  exams        Exam[]
  feeRecords   FeeRecord[]
}

model User {
  id              String             @id @default(cuid())
  email           String             @unique
  username        String?            @unique
  passwordHash    String
  displayName     String
  status          AccountStatus      @default(PENDING)
  emailVerified   Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  memberships     SchoolMembership[]
  studentProfile  Student?
}

model SchoolMembership {
  id        String   @id @default(cuid())
  schoolId  String
  userId    String
  role      Role
  createdAt DateTime @default(now())

  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([schoolId, userId, role])
  @@index([schoolId, role])
  @@index([userId])
}

model SchoolClass {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  section   String?
  createdAt DateTime @default(now())

  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students  Student[]
  subjects  Subject[]

  @@unique([schoolId, name, section])
  @@index([schoolId])
}

model Student {
  id            String   @id @default(cuid())
  schoolId      String
  userId        String?  @unique
  classId       String?
  admissionNo   String
  fullName      String
  guardianName  String?
  guardianPhone String?
  dateOfBirth   DateTime?
  createdAt     DateTime @default(now())

  school        School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  schoolClass   SchoolClass? @relation(fields: [classId], references: [id], onDelete: SetNull)
  attendance    Attendance[]
  feeRecords    FeeRecord[]
  marks         ExamMark[]

  @@unique([schoolId, admissionNo])
  @@index([schoolId, classId])
}

model Subject {
  id        String   @id @default(cuid())
  schoolId  String
  classId   String
  name      String
  createdAt DateTime @default(now())

  school    School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  marks     ExamMark[]

  @@unique([classId, name])
  @@index([schoolId])
}

model Attendance {
  id        String   @id @default(cuid())
  schoolId  String
  studentId String
  date      DateTime
  present   Boolean
  note      String?
  createdAt DateTime @default(now())

  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([schoolId, date])
}

model Exam {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  examDate  DateTime?
  createdAt DateTime @default(now())

  school    School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  marks     ExamMark[]

  @@index([schoolId])
}

model ExamMark {
  id        String   @id @default(cuid())
  examId    String
  studentId String
  subjectId String
  marks     Float
  createdAt DateTime @default(now())

  exam      Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId, subjectId])
}

model FeeRecord {
  id          String   @id @default(cuid())
  schoolId    String
  studentId   String
  description String
  amount      Decimal  @db.Decimal(10, 2)
  paidAmount  Decimal  @default(0) @db.Decimal(10, 2)
  dueDate     DateTime?
  paidAt      DateTime?
  createdAt   DateTime @default(now())

  school      School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student     Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId, studentId])
}
