
@import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap");

:root {
  font-family: "Inter", Arial, sans-serif;
  color: #19213c;
  background: #f6f7fc;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;

  --primary: #4f46e5;
  --primary-dark: #3730a3;
  --purple: #7c3aed;
  --text: #19213c;
  --muted: #788198;
  --border: #e8eaf2;
  --surface: #ffffff;
  --background: #f6f7fc;
  --sidebar-width: 260px;
}

* {
  box-sizing: border-box;
}

html {
  min-width: 320px;
  min-height: 100%;
  scroll-behavior: smooth;
}

body {
  min-width: 320px;
  min-height: 100vh;
  margin: 0;
  background: var(--background);
}

body,
button,
input,
textarea,
select {
  font-family: "Inter", Arial, sans-serif;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

button {
  cursor: pointer;
}

button:focus-visible,
a:focus-visible,
input:focus-visible {
  outline: 3px solid rgba(79, 70, 229, 0.3);
  outline-offset: 3px;
}

a {
  color: inherit;
}

#root {
  min-height: 100vh;
}

/* Main application layout */

.app-shell {
  min-height: 100vh;
  background: var(--background);
}

.sidebar {
  position: fixed;
  z-index: 50;
  inset: 0 auto 0 0;
  display: flex;
  flex-direction: column;
  width: var(--sidebar-width);
  padding: 24px 16px 16px;
  overflow-y: auto;
  background: #fff;
  border-right: 1px solid var(--border);
}

.brand {
  display: flex;
  align-items: center;
  gap: 11px;
  min-height: 48px;
  padding: 0 5px;
}

.brand-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 43px;
  width: 43px;
  height: 43px;
  color: #fff;
  background: linear-gradient(135deg, #4f46e5, #8b5cf6);
  border-radius: 14px;
  box-shadow: 0 5px 14px rgba(79, 70, 229, 0.2);
}

.brand strong,
.brand span {
  display: block;
}

.brand strong {
  color: #202746;
  font-size: 15px;
  font-weight: 800;
  letter-spacing: -0.4px;
}

.brand span {
  margin-top: 4px;
  color: #9399ac;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 1.7px;
}

.icon-button {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 40px;
  height: 40px;
  padding: 0;
  color: #69738c;
  background: transparent;
  border: 1px solid transparent;
  border-radius: 12px;
  transition:
    background 0.2s ease,
    color 0.2s ease,
    border-color 0.2s ease;
}

.icon-button:hover {
  color: var(--primary);
  background: #f0efff;
  border-color: #e8e5ff;
}

.close-menu,
.mobile-menu {
  display: none;
}

/* School switcher */

.school-switcher {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 0;
  margin-top: 30px;
  padding: 13px 10px;
  background: #f8f8ff;
  border: 1px solid #ededfb;
  border-radius: 14px;
}

.school-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 38px;
  width: 38px;
  height: 38px;
  color: #4f46e5;
  background: #e8e9ff;
  border-radius: 11px;
  font-size: 12px;
  font-weight: 800;
}

.school-details {
  flex: 1;
  min-width: 0;
}

.school-details strong,
.school-details span {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.school-details strong {
  color: #303752;
  font-size: 11px;
  font-weight: 700;
}

.school-details span {
  margin-top: 5px;
  color: #9399ac;
  font-size: 10px;
}

.switch-arrow {
  color: #858ba0;
  font-size: 18px;
}

/* Navigation */

.nav-heading {
  margin: 30px 10px 12px;
  color: #a0a5b7;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.6px;
}

.navigation {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.nav-item {
  position: relative;
  display: flex;
  align-items: center;
  gap: 12px;
  width: 100%;
  min-height: 46px;
  padding: 0 12px;
  color: #737c95;
  text-align: left;
  background: transparent;
  border: 1px solid transparent;
  border-radius: 12px;
  font-size: 12px;
  font-weight: 600;
  transition: all 0.18s ease;
}

.nav-item:hover {
  color: var(--primary);
  background: #f7f6ff;
}

.nav-item.active {
  color: #4f46e5;
  background: linear-gradient(100deg, #eeedff, #f7f5ff);
  border-color: #e8e5ff;
}

.active-dot {
  width: 6px;
  height: 6px;
  margin-left: auto;
  background: #6558ec;
  border-radius: 50%;
}

.sidebar-bottom {
  margin-top: auto;
  padding-top: 25px;
}

.help-card {
  padding: 16px;
  background: linear-gradient(145deg, #f0efff, #f9f7ff);
  border: 1px solid #e7e4ff;
  border-radius: 16px;
}

.help-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  color: #fff;
  background: #6658e8;
  border-radius: 9px;
  font-size: 15px;
  font-weight: 800;
}

.help-card strong {
  display: block;
  margin-top: 12px;
  color: #30345c;
  font-size: 12px;
}

.help-card p {
  margin: 7px 0 13px;
  color: #7d819f;
  font-size: 10px;
  line-height: 1.7;
}

.help-card button {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 0;
  color: #5548dc;
  background: transparent;
  border: 0;
  font-size: 10px;
  font-weight: 700;
}

.version {
  margin-top: 18px;
  color: #a0a5b5;
  text-align: center;
  font-size: 9px;
}

/* Main content and topbar */

.main-area {
  min-height: 100vh;
  margin-left: var(--sidebar-width);
}

.topbar {
  position: sticky;
  z-index: 20;
  top: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  min-height: 76px;
  padding: 12px 32px;
  background: rgba(255, 255, 255, 0.94);
  border-bottom: 1px solid var(--border);
  backdrop-filter: blur(14px);
}

.breadcrumb {
  display: flex;
  align-items: center;
  gap: 10px;
  color: #a1a6b6;
  font-size: 12px;
}

.breadcrumb a {
  color: #8b91a7;
  text-decoration: none;
}

.breadcrumb a:hover {
  color: var(--primary);
}

.breadcrumb strong {
  color: #353d59;
  font-weight: 700;
}

.top-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.search-box {
  display: flex;
  align-items: center;
  gap: 9px;
  width: 220px;
  height: 40px;
  padding: 0 11px;
  color: #9aa0b2;
  background: #f8f9fc;
  border: 1px solid #eceef5;
  border-radius: 12px;
}

.search-box input {
  width: 100%;
  min-width: 0;
  padding: 0;
  color: #313954;
  background: transparent;
  border: 0;
  outline: none;
  font-size: 11px;
}

.search-box input:focus-visible {
  outline: none;
}

.search-box kbd {
  padding: 3px 6px;
  color: #9ca2b4;
  background: #fff;
  border: 1px solid #e6e8f0;
  border-radius: 5px;
  font-size: 10px;
}

.notification > span {
  position: absolute;
  top: 8px;
  right: 8px;
  width: 7px;
  height: 7px;
  background: #f97373;
  border: 2px solid #fff;
  border-radius: 50%;
}

.profile-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 38px;
  width: 38px;
  height: 38px;
  color: #5b4be3;
  background: linear-gradient(145deg, #eceaff, #dcd8ff);
  border: 1px solid #dedaff;
  border-radius: 13px;
  font-size: 12px;
  font-weight: 800;
}

.page-content {
  width: 100%;
  max-width: 1600px;
  margin: 0 auto;
  padding: 32px;
}

.welcome-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 25px;
}

.eyebrow {
  color: #7568df;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.5px;
}

.welcome-row h1 {
  margin: 10px 0 7px;
  color: #1e2542;
  font-size: clamp(25px, 3vw, 32px);
  font-weight: 800;
  letter-spacing: -1.2px;
}

.subtitle {
  margin: 0;
  color: #8b92a7;
  font-size: 12px;
  line-height: 1.7;
}

.date-chip {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  padding: 11px 14px;
  color: #6358d6;
  background: #fff;
  border: 1px solid #e9e7fb;
  border-radius: 12px;
  font-size: 11px;
  font-weight: 600;
  white-space: nowrap;
}

/* Notice banner */

.notice-banner {
  display: flex;
  align-items: center;
  gap: 15px;
  margin-bottom: 23px;
  padding: 19px 21px;
  background: linear-gradient(110deg, #eeedff, #f9f7ff);
  border: 1px solid #e4e1ff;
  border-radius: 17px;
}

.notice-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 46px;
  width: 46px;
  height: 46px;
  color: #5d50dc;
  background: #fff;
  border: 1px solid #e9e5ff;
  border-radius: 14px;
}

.notice-banner strong {
  display: block;
  color: #302c66;
  font-size: 13px;
  font-weight: 800;
}

.notice-banner p {
  margin: 6px 0 0;
  color: #777b9c;
  font-size: 11px;
  line-height: 1.7;
}

/* Statistics cards */

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 17px;
  margin-bottom: 22px;
}

.stat-card {
  min-width: 0;
  padding: 19px;
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 17px;
  box-shadow: 0 4px 15px rgba(38, 44, 90, 0.025);
  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease;
}

.stat-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 10px 25px rgba(38, 44, 90, 0.07);
}

.stat-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.stat-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 43px;
  height: 43px;
  color: #6255df;
  background: #f0efff;
  border-radius: 13px;
}

.stat-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #a4a9ba;
}

.stat-card > p {
  margin: 18px 0 8px;
  color: #828aa0;
  font-size: 11px;
  font-weight: 600;
}

.stat-card h2 {
  margin: 0;
  color: #242b48;
  font-size: clamp(22px, 2.5vw, 29px);
  font-weight: 800;
  letter-spacing: -0.8px;
  overflow-wrap: anywhere;
}

.stat-note {
  display: block;
  margin-top: 9px;
  color: #8b92a6;
  font-size: 10px;
  line-height: 1.5;
}

/* Content panels */

.content-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
  gap: 20px;
  margin-bottom: 22px;
}

.panel {
  min-width: 0;
  padding: 22px;
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 17px;
  box-shadow: 0 4px 15px rgba(38, 44, 90, 0.025);
}

.panel-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  margin-bottom: 20px;
}

.panel-heading h3 {
  margin: 0;
  color: #262d49;
  font-size: 14px;
  font-weight: 800;
}

.panel-heading p {
  margin: 7px 0 0;
  color: #9299ac;
  font-size: 10px;
  line-height: 1.6;
}

.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 6px 10px;
  color: #6355db;
  background: #f0efff;
  border: 1px solid #e7e4ff;
  border-radius: 20px;
  font-size: 9px;
  font-weight: 700;
  white-space: nowrap;
}

/* Attendance chart */

.chart {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  gap: 12px;
  min-height: 215px;
  padding-top: 12px;
}

.chart-column {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  gap: 11px;
  min-width: 0;
}

.bar-track {
  display: flex;
  align-items: flex-end;
  width: 100%;
  max-width: 35px;
  height: 175px;
  padding: 0;
  overflow: hidden;
  background: #f4f3ff;
  border-radius: 8px 8px 5px 5px;
}

.bar {
  width: 100%;
  min-height: 8px;
  background: linear-gradient(180deg, #a39af8, #7568e8);
  border-radius: 7px 7px 3px 3px;
  transition: height 0.3s ease;
}

.bar-highlight {
  background: linear-gradient(180deg, #7c6cf0, #4f46e5);
}

.chart-column > span {
  color: #959bb0;
  font-size: 9px;
}

/* Quick action list */

.quick-action {
  display: flex;
  align-items: center;
  gap: 11px;
  width: 100%;
  min-height: 53px;
  padding: 9px 0;
  color: #4a526d;
  text-align: left;
  background: transparent;
  border: 0;
  border-bottom: 1px solid #f0f1f6;
  font-size: 11px;
  font-weight: 600;
  transition: color 0.2s ease;
}

.quick-action:last-child {
  border-bottom: 0;
}

.quick-action:hover {
  color: var(--primary);
}

.quick-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 34px;
  width: 34px;
  height: 34px;
  color: #6759e5;
  background: #f0efff;
  border-radius: 11px;
}

.quick-action > span:nth-child(2) {
  flex: 1;
}

.quick-action > svg {
  color: #a4a9ba;
}

/* Empty states and preview sections */

.bottom-panel {
  margin-bottom: 22px;
}

.empty-state {
  display: flex;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  min-height: 170px;
  padding: 20px;
  text-align: center;
  background: #fafaff;
  border: 1px dashed #e4e4f2;
  border-radius: 14px;
}

.empty-icon,
.preview-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 47px;
  height: 47px;
  color: #6c5ce7;
  background: #eeedff;
  border-radius: 15px;
}

.empty-state strong {
  margin-top: 13px;
  color: #444b68;
  font-size: 12px;
}

.empty-state p {
  max-width: 420px;
  margin: 8px 0 0;
  color: #9097aa;
  font-size: 11px;
  line-height: 1.8;
}

.section-preview {
  display: flex;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  min-height: 360px;
  text-align: center;
}

.section-preview h2 {
  margin: 19px 0 8px;
  color: #222a47;
  font-size: 24px;
}

.section-preview p {
  max-width: 510px;
  margin: 0 0 18px;
  color: #7f879d;
  font-size: 12px;
  line-height: 1.9;
}

.section-preview .primary-button {
  margin-top: 22px;
}

.primary-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  padding: 0 19px;
  color: #fff;
  background: linear-gradient(120deg, #4f46e5, #7658e9);
  border: 1px solid transparent;
  border-radius: 11px;
  box-shadow: 0 5px 14px rgba(79, 70, 229, 0.16);
  font-size: 11px;
  font-weight: 700;
  text-decoration: none;
  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease;
}

.primary-button:hover {
  transform: translateY(-1px);
  box-shadow: 0 8px 18px rgba(79, 70, 229, 0.23);
}

/* Footer */

.footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  padding: 8px 0 4px;
  color: #a0a6b7;
  font-size: 10px;
  line-height: 1.7;
}

/* Public pages */

.public-message-page,
.login-page-wrapper {
  min-height: 100vh;
  padding: 24px;
  background:
    radial-gradient(
      circle at 10% 0%,
      rgba(125, 110, 245, 0.12),
      transparent 35%
    ),
    radial-gradient(
      circle at 95% 90%,
      rgba(99, 102, 241, 0.08),
      transparent 30%
    ),
    #f7f8fc;
}

.public-message-page {
  display: flex;
  align-items: center;
  justify-content: center;
}

.public-message-card {
  width: 100%;
  max-width: 480px;
  padding: 36px;
  text-align: center;
  background: #fff;
  border: 1px solid #e7e9f2;
  border-radius: 24px;
  box-shadow: 0 20px 60px rgba(35, 40, 90, 0.08);
}

.public-message-icon,
.login-page-brand-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 54px;
  height: 54px;
  color: #fff;
  background: linear-gradient(135deg, #4058d6, #7950d8);
  border-radius: 16px;
}

.public-message-card h1 {
  margin: 20px 0 12px;
  color: #171b36;
  font-size: 28px;
  letter-spacing: -0.8px;
}

.public-message-card p {
  margin-bottom: 24px;
  color: #68708a;
  font-size: 13px;
  line-height: 1.8;
}

.public-message-card .primary-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 46px;
  padding: 0 22px;
  color: #fff;
  background: #4658d6;
  border: 0;
  border-radius: 12px;
  text-decoration: none;
  font-weight: 600;
}

.secondary-link {
  display: block;
  margin-top: 20px;
  color: #4658d6;
  text-decoration: none;
  font-size: 12px;
  font-weight: 600;
}

.secondary-link:hover {
  text-decoration: underline;
}

.login-page-wrapper {
  display: flex;
  flex-direction: column;
}

.login-page-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  width: 100%;
  max-width: 1100px;
  margin: 0 auto 36px;
}

.back-home-link {
  color: #4658d6;
  text-decoration: none;
  font-size: 12px;
  font-weight: 600;
}

.back-home-link:hover {
  text-decoration: underline;
}

.login-page-brand {
  display: flex;
  align-items: center;
  gap: 12px;
}

.login-page-brand strong,
.login-page-brand span {
  display: block;
}

.login-page-brand strong {
  color: #171b36;
  font-size: 15px;
}

.login-page-brand span {
  margin-top: 4px;
  color: #7b8197;
  font-size: 9px;
  letter-spacing: 1px;
}

.login-page-footer {
  margin: 28px auto 0;
  color: #7b8197;
  text-align: center;
  font-size: 11px;
}

/* Mobile overlay */

.mobile-overlay {
  display: none;
}

/* Tablet */

@media (max-width: 1100px) {
  :root {
    --sidebar-width: 230px;
  }

  .sidebar {
    padding-right: 12px;
    padding-left: 12px;
  }

  .topbar {
    padding-right: 22px;
    padding-left: 22px;
  }

  .page-content {
    padding: 24px 22px;
  }

  .stats-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .stat-card {
    padding: 17px;
  }

  .content-grid {
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
  }
}

/* Mobile */

@media (max-width: 760px) {
  :root {
    --sidebar-width: 260px;
  }

  .sidebar {
    z-index: 100;
    width: min(290px, 85vw);
    transform: translateX(-105%);
    transition: transform 0.25s ease;
    box-shadow: none;
  }

  .sidebar.sidebar-open {
    transform: translateX(0);
    box-shadow: 12px 0 35px rgba(25, 30, 70, 0.12);
  }

  .close-menu {
    display: inline-flex;
    margin-left: auto;
  }

  .mobile-menu {
    display: inline-flex;
  }

  .mobile-overlay {
    position: fixed;
    z-index: 90;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    background: rgba(20, 24, 50, 0.35);
    border: 0;
    backdrop-filter: blur(2px);
  }

  .main-area {
    margin-left: 0;
  }

  .topbar {
    min-height: 66px;
    gap: 10px;
    padding: 10px 14px;
  }

  .breadcrumb {
    flex: 1;
    gap: 7px;
    font-size: 11px;
  }

  .top-actions {
    gap: 5px;
  }

  .search-box {
    width: 40px;
    padding: 0 10px;
    border-color: transparent;
    background: transparent;
  }

  .search-box input,
  .search-box kbd {
    display: none;
  }

  .search-box:focus-within {
    position: absolute;
    z-index: 5;
    right: 100px;
    left: 65px;
    width: auto;
    background: #fff;
    border-color: var(--border);
  }

  .search-box:focus-within input {
    display: block;
  }

  .profile-avatar {
    flex-basis: 34px;
    width: 34px;
    height: 34px;
  }

  .top-actions .icon-button {
    width: 34px;
    height: 34px;
  }

  .page-content {
    padding: 22px 15px;
  }

  .welcome-row {
    align-items: flex-start;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 20px;
  }

  .welcome-row h1 {
    font-size: 27px;
  }

  .date-chip {
    padding: 9px 12px;
  }

  .notice-banner {
    align-items: flex-start;
    gap: 12px;
    padding: 15px;
  }

  .notice-symbol {
    flex-basis: 40px;
    width: 40px;
    height: 40px;
  }

  .notice-banner strong {
    font-size: 12px;
    line-height: 1.6;
  }

  .notice-banner p {
    font-size: 10px;
  }

  .stats-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 11px;
  }

  .stat-card {
    padding: 14px;
    border-radius: 14px;
  }

  .stat-icon {
    width: 37px;
    height: 37px;
    border-radius: 11px;
  }

  .stat-card > p {
    margin-top: 14px;
    font-size: 10px;
  }

  .stat-card h2 {
    font-size: 23px;
  }

  .stat-note {
    font-size: 9px;
  }

  .content-grid {
    grid-template-columns: minmax(0, 1fr);
    gap: 14px;
  }

  .panel {
    padding: 17px;
    border-radius: 15px;
  }

  .chart {
    min-height: 200px;
  }

  .bar-track {
    height: 160px;
  }

  .footer {
    align-items: flex-start;
    flex-direction: column;
    gap: 6px;
    padding-top: 12px;
  }

  .login-page-top {
    align-items: flex-start;
    flex-direction: column;
    margin-bottom: 26px;
  }

  .login-page-brand {
    align-items: center;
  }

  .public-message-card {
    padding: 27px 20px;
  }
}

/* Small phones */

@media (max-width: 380px) {
  .topbar {
    padding-right: 9px;
    padding-left: 9px;
  }

  .top-actions {
    gap: 1px;
  }

  .breadcrumb {
    gap: 5px;
    font-size: 10px;
  }

  .page-content {
    padding-right: 11px;
    padding-left: 11px;
  }

  .stats-grid {
    gap: 8px;
  }

  .stat-card {
    padding: 11px;
  }

  .stat-card h2 {
    font-size: 20px;
  }

  .panel {
    padding: 14px;
  }

  .chart {
    gap: 7px;
  }
}

/* Reduced motion accessibility */

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
  }
}
